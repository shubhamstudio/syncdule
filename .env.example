# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SYNCDULE
NEXT_PUBLIC_APP_OWNER=Shubham Bisht

# Public URL of this app (required for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Uncomment when using a dev tunnel (e.g. ngrok, Cloudflare Tunnel):
# NEXT_PUBLIC_DEV_ORIGIN=https://your-tunnel.example.com

# ─── InsForge ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_PROJECT_API_KEY=
INSFORGE_STORAGE_BUCKET=sociostack

# ─── Groq AI (server-only) ────────────────────────────────────────────────────
# Create a server API key at https://console.groq.com/keys. Never expose it to the browser.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Razorpay credentials belong in InsForge Payments configuration, not here.
# Create monthly Razorpay Plans, then put only their non-secret IDs here.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_GROWTH=

# ─── Clerk (Authentication) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_INSFORGE_TEMPLATE=insforge
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/calendar
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/calendar

# ─── Social OAuth Security ────────────────────────────────────────────────────
# Two independent random secrets — generate with: openssl rand -hex 32
CHANNEL_OAUTH_STATE_SECRET=
CHANNEL_TOKEN_ENCRYPTION_KEY=

# ─── Inngest (Background Jobs) ────────────────────────────────────────────────
# Local only: set this to 1 and run `npm run inngest:dev` in a second terminal.
# Deployed environments must omit it so Inngest Cloud can trigger the worker.
# INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── LinkedIn OAuth 2.0 / OpenID Connect ──────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTH_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_PROFILE_URL=https://api.linkedin.com/v2/userinfo
LINKEDIN_SCOPES=openid,profile,email,w_member_social

# ─── Instagram (Instagram Login / Graph API) ──────────────────────────────────
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTH_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_PROFILE_URL=https://graph.instagram.com/me?fields=id,username,account_type,media_count
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# ─── Facebook (Graph API) ─────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_AUTH_URL=https://www.facebook.com/v23.0/dialog/oauth
FACEBOOK_TOKEN_URL=https://graph.facebook.com/v23.0/oauth/access_token
FACEBOOK_PROFILE_URL=https://graph.facebook.com/v23.0/me?fields=id,name,picture
FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts

# ─── YouTube (Google OAuth 2.0 / YouTube Data API v3) ─────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
YOUTUBE_TOKEN_URL=https://oauth2.googleapis.com/token
YOUTUBE_PROFILE_URL=https://www.googleapis.com/youtube/v3/channels?part=snippet&mine=true
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.force-ssl
